# Example environment variables (do NOT commit this file)

# Preferred TTS provider: gtts, elevenlabs, google, pyttsx3
TTS_PROVIDER=gtts

# ElevenLabs (if you choose it)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Google Cloud TTS (if you choose it)
# Provide the path to your Google service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-service-account.json

# YouTube API key (if you later add upload functionality)
# YT_API_KEY=your_youtube_api_key_here

# Streamlit Community Cloud: no token needed for basic deploy
